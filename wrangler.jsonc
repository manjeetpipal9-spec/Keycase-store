{
  "name": "keycase-store",
  "main": "worker.js",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js"],
      "fallthrough": true
    }
  ]
}
